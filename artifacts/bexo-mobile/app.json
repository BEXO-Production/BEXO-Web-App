{
  "expo": {
    "name": "BEXO",
    "slug": "bexo-mobile",
    "scheme": "bexo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F1EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bexo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F3F1EC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bexo.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F1EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
