# Copy to `.env` (local) or seed `.env.cloudrun.yaml` (Cloud Run — gitignored).
NODE_ENV=production
PLATFORM_DOMAIN=atbexo.com
BEXO_PLATFORM_DOMAIN=atbexo.com
# App SPA (login / onboarding / dashboard) — Cloudflare-style dash host
FRONTEND_URL=https://dash.mybexo.com
WEB_URL=https://dash.mybexo.com

# Supabase production — project "BEXO from Ace Digital" (nyyfcwblrnjnvhiynryb)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.nyyfcwblrnjnvhiynryb.supabase.co:5432/postgres
# API server (link-google / Auth verify) — prefer non-VITE names
SUPABASE_URL=https://nyyfcwblrnjnvhiynryb.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional fallback for local/dev if you already use Vite names
VITE_SUPABASE_URL=https://nyyfcwblrnjnvhiynryb.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional: JWT secret from Supabase → Project Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=

VITE_PLATFORM_DOMAIN=atbexo.com
VITE_MARKETING_ORIGIN=https://mybexo.com
VITE_DASH_ORIGIN=https://dash.mybexo.com
VITE_API_URL=https://dash.mybexo.com
VITE_RENDERING_URL=https://atbexo.com

JWT_SECRET=
JWT_REFRESH_SECRET=
# Also required in Cloud Run: MSG91_*, R2_*, RAZORPAY_*, SMTP_*, OPENROUTER_*
